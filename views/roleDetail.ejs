<!DOCTYPE html>
<html>

<head>
	<title>Role Detail - <%= role[pathway.id][levelId].title %></title>
	<%- include('_styles') %>
</head>

<body>
	<div class="page">
		<%- include('_nav') %>

		<section class="hero">
			<h1><%= role[pathway.id][levelId].title %></h1>
			<p>
				<span class="badge badge--accent"><%= role.name %></span>
				<span class="badge"><%= pathway.description %></span>
				<span class="badge badge--ok">Level <%= levelId %></span>
			</p>
		</section>

		<% let level = role[pathway.id][levelId] %>
		<% const skillsById = new Map((skills.skills || []).map(s => [s.id, s])) %>

		<div style="display: flex; flex-direction: column; gap: 12px;">
			<% skills.categories.forEach(category=> { %>
				<section class="card">
					<div class="card__body">
						<div class="item-title">
							<div class="item-title__name"><%= category.name %></div>
							<div class="badge"><%= category.id %></div>
						</div>

						<% const selected = (level && Array.isArray(level.selected_skills)) ? level.selected_skills : [] %>
						<% const entries = selected.map(e => ({ entry: e, skill: skillsById.get(e.skill_id) })).filter(x => x.skill && x.skill.category_id === category.id) %>
						<% entries.sort((a,b) => (a.skill.name || '').localeCompare(b.skill.name || '')) %>
						<div style="margin-top: 8px;">
							<span class="badge"><%= entries.length %> skills</span>
						</div>

						<% if (entries.length === 0) { %>
							<div style="color: var(--muted); font-size: 13px;">
								No selected skills in this category for this role/pathway/level.
							</div>
						<% } %>

						<% if (entries.length > 0) { %>
							<div class="table-wrap" style="margin-top: 10px;">
								<table style="min-width: 720px;">
									<thead>
										<tr>
											<th>Skill</th>
											<th>Required Level</th>
											<th>Description</th>
											<% if (votingAvailable) { %><th>Community</th><% } %>
										</tr>
									</thead>
									<tbody>
										<% entries.forEach(({ skill, entry }) => { %>
											<% const competency = entry.required_level %>
											<% let skillLevel = (skill.levels || []).find(l => l.level == competency) %>
											<% let lev = (skills.levels || []).find(l => l.level == competency) %>
											<% const skillVotes = votesBySkill[skill.id] || {} %>
											<% const myVote = myVotes[skill.id] %>
											<tr>
												<td>
													<div class="item-title">
														<a class="item-title__name" href="/skills/<%= skill.id %>/"><%= skill.name %></a>
														<span class="badge"><%= skill.id %></span>
													</div>
												</td>
												<td>
													<a href="/skills/<%= skill.id %>/level/<%= competency %>">
														<span class="badge badge--ok">Level <%= competency %><% if (lev) { %> • <%= lev.level_name %><% } %></span>
													</a>
												</td>
												<td style="color: var(--muted); font-size: 13px;">
													<% if (skillLevel) { %>
														<% const brief = (skillLevel.brief_description || '').trim() %>
														<% const full = (skillLevel.full_description || '').trim() %>
														<% if (brief) { %>
															<%= brief %>
														<% } else if (full) { %>
															<%= full.length > 220 ? (full.slice(0, 220) + '…') : full %>
														<% } else { %>
															<span style="color: var(--faint);">No skill-level description available.</span>
														<% } %>
													<% } else { %>
														<span style="color: var(--faint);">No skill-level description available.</span>
													<% } %>
												</td>
																			<% if (votingAvailable) { %>
												<td>
													<% const voteLevels = Object.keys(skillVotes).map(Number).sort((a,b) => a-b) %>
													<% if (voteLevels.length > 0) { %>
														<div class="vote-bars">
															<% voteLevels.forEach(lvl => { %>
																<span class="vote-bar<%= myVote == lvl ? ' vote-bar--mine' : '' %>">
																	L<%= lvl %> <span class="vote-bar__count">×<%= skillVotes[lvl] %></span>
																</span>
															<% }) %>
														</div>
													<% } %>
													<form class="vote-form" method="POST" action="/roles/<%= role.id %>/pathway/<%= pathway.id %>/level/<%= levelId %>/vote">
														<input type="hidden" name="skill_id" value="<%= skill.id %>">
														<select name="suggested_level" aria-label="Suggested level for <%= skill.name %>">
															<% for (let lvl = 1; lvl <= 7; lvl++) { %>
																<option value="<%= lvl %>" <%= myVote == lvl ? 'selected' : '' %>>Level <%= lvl %></option>
															<% } %>
														</select>
														<button type="submit"><%= myVote ? 'Update' : 'Vote' %></button>
													</form>
												</td>
												<% } %>
											</tr>
										<% }) %>
									</tbody>
								</table>
							</div>
						<% } %>
					</div>
				</section>
			<% }); %>
		</div>

		<%- include('_footer') %>
	</div>
</body>

</html>
