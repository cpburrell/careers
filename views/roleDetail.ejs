<!DOCTYPE html>
<html>

<head>
	<title>Role Detail - <%= role[pathway.id][levelId].title %></title>
	<%- include('_styles') %>
</head>

<body>
	<div class="page">
		<%- include('_nav') %>

		<section class="hero">
			<h1><%= role[pathway.id][levelId].title %></h1>
			<p>
				<span class="badge badge--accent"><%= role.name %></span>
				<span class="badge"><%= pathway.description %></span>
				<span class="badge badge--ok">Level <%= levelId %></span>
			</p>
		</section>

		<% let level = role[pathway.id][levelId] %>
		<% const skillsById = new Map((skills.skills || []).map(s => [s.id, s])) %>
		<% const selectedSkillIds = new Set((level && Array.isArray(level.selected_skills) ? level.selected_skills : []).map(e => e.skill_id)) %>

		<div style="display: flex; flex-direction: column; gap: 12px;">
			<% skills.categories.forEach(category=> { %>
				<section class="card">
					<div class="card__body">
						<div class="item-title">
							<div class="item-title__name"><%= category.name %></div>
							<div class="badge"><%= category.id %></div>
						</div>

						<% const selected = (level && Array.isArray(level.selected_skills)) ? level.selected_skills : [] %>
						<% const entries = selected.map(e => ({ entry: e, skill: skillsById.get(e.skill_id) })).filter(x => x.skill && x.skill.category_id === category.id) %>
						<% entries.sort((a,b) => (a.skill.name || '').localeCompare(b.skill.name || '')) %>
						<div style="margin-top: 8px;">
							<span class="badge"><%= entries.length %> skills</span>
						</div>

						<% if (entries.length === 0) { %>
							<div style="color: var(--muted); font-size: 13px;">
								No selected skills in this category for this role/pathway/level.
							</div>
						<% } %>

						<% if (entries.length > 0) { %>
							<div class="table-wrap" style="margin-top: 10px;">
								<table style="min-width: 720px;">
									<thead>
										<tr>
											<th>Skill</th>
											<th>Required Level</th>
											<th>Description</th>
											<% if (votingAvailable) { %><th>Community</th><% } %>
										</tr>
									</thead>
									<tbody>
										<% entries.forEach(({ skill, entry }) => { %>
											<% const competency = entry.required_level %>
											<% let skillLevel = (skill.levels || []).find(l => l.level == competency) %>
											<% let lev = (skills.levels || []).find(l => l.level == competency) %>
											<% const skillVotes = votesBySkill[skill.id] || {} %>
											<% const myVote = myVotes[skill.id] %>
											<% const skillPresence = presenceVotesBySkill[skill.id] || { remove: 0, add: {} } %>
											<% const myPresence = myPresenceVotes[skill.id] %>
											<tr>
												<td>
													<div class="item-title">
														<a class="item-title__name" href="/skills/<%= skill.id %>/"><%= skill.name %></a>
														<span class="badge"><%= skill.id %></span>
													</div>
												</td>
												<td>
													<a href="/skills/<%= skill.id %>/level/<%= competency %>">
														<span class="badge badge--ok">Level <%= competency %><% if (lev) { %> • <%= lev.level_name %><% } %></span>
													</a>
												</td>
												<td style="color: var(--muted); font-size: 13px;">
													<% if (skillLevel) { %>
														<% const brief = (skillLevel.brief_description || '').trim() %>
														<% const full = (skillLevel.full_description || '').trim() %>
														<% if (brief) { %>
															<%= brief %>
														<% } else if (full) { %>
															<%= full.length > 220 ? (full.slice(0, 220) + '…') : full %>
														<% } else { %>
															<span style="color: var(--faint);">No skill-level description available.</span>
														<% } %>
													<% } else { %>
														<span style="color: var(--faint);">No skill-level description available.</span>
													<% } %>
												</td>
												<% if (votingAvailable) { %>
												<td>
													<%
														const totalVotes = Object.values(skillVotes).reduce((s, c) => s + c, 0);
														const weightedSum = Object.entries(skillVotes).reduce((s, [lvl, c]) => s + Number(lvl) * c, 0);
														const voteAvg = totalVotes > 0 ? (weightedSum / totalVotes).toFixed(1) : null;
													%>
													<% if (voteAvg) { %>
														<div>
															<span class="vote-avg">
																Avg <span class="vote-avg__value">L<%= voteAvg %></span>
																<span style="color:var(--muted);">(<%= totalVotes %> vote<%= totalVotes !== 1 ? 's' : '' %>)</span>
															</span>
														</div>
													<% } %>

													<% const voteLevels = Object.keys(skillVotes).map(Number).sort((a,b) => a-b) %>
													<% if (voteLevels.length > 0) { %>
														<div class="vote-bars">
															<% voteLevels.forEach(lvl => { %>
																<span class="vote-bar<%= myVote == lvl ? ' vote-bar--mine' : '' %>">
																	L<%= lvl %> <span class="vote-bar__count">×<%= skillVotes[lvl] %></span>
																</span>
															<% }) %>
														</div>
													<% } %>

													<form class="vote-form" method="POST" action="/roles/<%= role.id %>/pathway/<%= pathway.id %>/level/<%= levelId %>/vote">
														<input type="hidden" name="skill_id" value="<%= skill.id %>">
														<select name="suggested_level" aria-label="Suggested level for <%= skill.name %>">
															<% for (let lvl = 1; lvl <= 7; lvl++) { %>
																<option value="<%= lvl %>" <%= myVote == lvl ? 'selected' : '' %>>Level <%= lvl %></option>
															<% } %>
														</select>
														<button type="submit"><%= myVote ? 'Update' : 'Vote' %></button>
													</form>

													<div class="remove-vote">
														<% if (skillPresence.remove > 0) { %>
															<span class="remove-vote__count"><%= skillPresence.remove %> removal vote<%= skillPresence.remove !== 1 ? 's' : '' %></span>
														<% } %>
														<form method="POST" action="/roles/<%= role.id %>/pathway/<%= pathway.id %>/level/<%= levelId %>/presence-vote">
															<input type="hidden" name="skill_id" value="<%= skill.id %>">
															<input type="hidden" name="vote_type" value="remove">
															<button type="submit" class="<%= myPresence && myPresence.voteType === 'remove' ? 'voted' : '' %>">
																<%= myPresence && myPresence.voteType === 'remove' ? '✓ Voted to remove' : 'Vote to remove' %>
															</button>
														</form>
													</div>
												</td>
												<% } %>
											</tr>
										<% }) %>
									</tbody>
								</table>
							</div>
						<% } %>
					</div>
				</section>
			<% }); %>

			<% if (votingAvailable) { %>
				<%
					// Build list of skills with add votes, sorted by total votes desc
					const addVoteEntries = Object.entries(presenceVotesBySkill)
						.filter(([, p]) => Object.keys(p.add).length > 0)
						.map(([skillId, p]) => {
							const totalAddVotes = Object.values(p.add).reduce((s, c) => s + c, 0);
							const levels = Object.entries(p.add).map(([lvl, c]) => ({ lvl: Number(lvl), count: c })).sort((a,b) => a.lvl - b.lvl);
							return { skillId, totalAddVotes, levels, skill: skillsById.get(skillId) };
						})
						.sort((a, b) => b.totalAddVotes - a.totalAddVotes);

					// Skills available to add (not already in selected_skills)
					const addableSkills = (skills.skills || [])
						.filter(s => !selectedSkillIds.has(s.id))
						.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
				%>
				<section class="card additions-section">
					<div class="card__body">
						<div class="item-title">
							<div class="item-title__name">Community Skill Additions</div>
							<div class="badge">suggested</div>
						</div>

						<% if (addVoteEntries.length > 0) { %>
							<div class="additions-list">
								<% addVoteEntries.forEach(({ skillId, totalAddVotes, levels, skill }) => { %>
									<div class="addition-row">
										<% if (skill) { %>
											<a class="addition-row__name" href="/skills/<%= skillId %>/"><%=skill.name %></a>
											<span class="badge"><%= skillId %></span>
										<% } else { %>
											<span class="addition-row__name"><%= skillId %></span>
										<% } %>
										<div class="vote-bars" style="margin:0;">
											<% levels.forEach(({ lvl, count }) => { %>
												<% const myAdd = myPresenceVotes[skillId] %>
												<span class="vote-bar<%= myAdd && myAdd.voteType === 'add' && myAdd.suggestedLevel == lvl ? ' vote-bar--mine' : '' %>">
													L<%= lvl %> <span class="vote-bar__count">×<%= count %></span>
												</span>
											<% }) %>
										</div>
										<span style="font-size:11px;color:var(--muted);"><%= totalAddVotes %> vote<%= totalAddVotes !== 1 ? 's' : '' %></span>
									</div>
								<% }) %>
							</div>
						<% } else { %>
							<p style="color:var(--muted);font-size:13px;margin:8px 0;">No community additions suggested yet.</p>
						<% } %>

						<% if (addableSkills.length > 0) { %>
							<form class="vote-form" style="margin-top:12px;" method="POST" action="/roles/<%= role.id %>/pathway/<%= pathway.id %>/level/<%= levelId %>/presence-vote">
								<input type="hidden" name="vote_type" value="add">
								<select name="skill_id" aria-label="Skill to add">
									<% addableSkills.forEach(s => { %>
										<option value="<%= s.id %>"><%= s.name %> (<%= s.id %>)</option>
									<% }) %>
								</select>
								<select name="suggested_level" aria-label="Suggested level">
									<% for (let lvl = 1; lvl <= 7; lvl++) { %>
										<option value="<%= lvl %>">Level <%= lvl %></option>
									<% } %>
								</select>
								<button type="submit">Suggest addition</button>
							</form>
						<% } %>
					</div>
				</section>
			<% } %>
		</div>

		<%- include('_footer') %>
	</div>
</body>

</html>
