# App
PORT=3000
APP_PORT=3000
APP_DEBUG_PORT=9229

# Data source: "file" (default) or "db"
CAREERS_DATA_SOURCE=file

# App -> MariaDB connection (for voting feature)
MARIADB_HOST=mariadb.cburrell.com
MARIADB_PORT=3306
MARIADB_USER=careers
MARIADB_PASSWORD=
MARIADB_DATABASE=careers
# Set to "true" to enable SSL (recommended for remote servers)
MARIADB_SSL=true
